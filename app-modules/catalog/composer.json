{
    "name": "tequia/catalog",
    "description": "Gestión de productos artesanales, variantes, existencias y fotografías.",
    "type": "library",
    "version": "1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Tequia\\Catalog\\": "src/",
            "Tequia\\Catalog\\Tests\\": "tests/",
            "Tequia\\Catalog\\Database\\Factories\\": "database/factories/",
            "Tequia\\Catalog\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Tequia\\Catalog\\Providers\\CatalogServiceProvider"
            ]
        }
    }
}
